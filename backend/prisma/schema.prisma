// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Email verification
  emailVerified     Boolean   @default(false)
  emailVerifyToken  String?
  emailVerifyExpiry DateTime?

  // 2FA
  twoFactorEnabled  Boolean @default(false)
  twoFactorSecret   String?

  // Onboarding
  onboardingStep      Int     @default(0)
  onboardingCompleted Boolean @default(false)

  // Token revocation (force-logout all devices)
  tokenRevokedAt DateTime?

  // Password reset
  passwordResetToken  String?
  passwordResetExpiry DateTime?

  // Relations
  profile              UserProfile?
  cycleParticipations  CycleParticipation[]
  activityEvents       ActivityEvent[]
  verifiedActivities   ActivityEvent[]      @relation("ActivityVerifier")
  feedbackGiven        ActivityEvent[]      @relation("ActivityFeedback")
  ownershipLedger      OwnershipLedger[]
  multipliers          Multiplier[]
  notifications        Notification[]
  disputes             Dispute[]
  auditTrailAsAdmin    AuditTrail[]         @relation("AdminAuditTrail")
  auditTrailAsTarget   AuditTrail[]         @relation("TargetAuditTrail")
  systemLogs           SystemLog[]
  archivedActivities   ArchivedActivity[]
  activitySessions     UserActivitySession[]
  sentMessages         CycleMessage[]       @relation("MessageAuthor")
  messageReads         MessageRead[]
  messageMentions      MessageMention[]
  reputation           ContributorReputation?
  securityEvents       SecurityEvent[]
  userAgreements       UserAgreement[]
  createdTasks         Task[]             @relation("TaskCreator")
  taskAssignments      TaskAssignment[]
  participationLeaves  ParticipationLeave[]
  accessGrants         AccessGrant[]      @relation("AccessGrantUser")
  grantedAccess        AccessGrant[]      @relation("AccessGrantGranter")
  adminActionLogs      AdminActionLog[]
  createdDocuments     Document[]         @relation("DocumentCreator")
  docAccessGrants      DocumentAccess[]   @relation("DocAccessUser")
  docAccessGranted     DocumentAccess[]   @relation("DocAccessGranter")
  docVersionUploads    DocumentVersion[]  @relation("DocVersionUploader")
  docActivity          DocumentActivity[] @relation("DocActivityUser")

  @@map("users")
}

model UserProfile {
  id                String @id @default(cuid())
  userId            String @unique
  role              String @default("contributor") // founder, admin, contributor, employee, observer
  status            String @default("active") // active, suspended
  bio               String?
  avatar            String?
  notificationPrefs String @default("{\"stallWarnings\":true,\"activityReminders\":true,\"cycleUpdates\":true}") // JSON

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model BuildCycle {
  id               String   @id @default(cuid())
  name             String
  description      String?  // Optional description for the cycle
  state            String // planned, active, paused, closed
  startDate        DateTime
  endDate          DateTime
  participantCount Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  participations   CycleParticipation[]
  activityEvents   ActivityEvent[]
  ownershipLedger  OwnershipLedger[]
  multipliers      Multiplier[]
  archivedActivities ArchivedActivity[]
  messages         CycleMessage[]
  engagement       CycleEngagement?
  tasks            Task[]
  participationLeaves ParticipationLeave[]

  @@map("build_cycles")
}

model CycleParticipation {
  id                  String    @id @default(cuid())
  userId              String
  cycleId             String
  optedIn             Boolean   @default(true)
  participationStatus String // active, at-risk, paused, grace
  stallStage          String // none, grace, active, at_risk, diminishing, paused
  lastActivityDate    DateTime?
  createdAt           DateTime  @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle BuildCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([userId, cycleId])
  @@map("cycle_participation")
}

model ActivityEvent {
  id                  String    @id @default(cuid())
  userId              String
  cycleId             String
  activityType        String    // code, documentation, review, task_completion, hours_logged, meeting, research
  proofLink           String
  description         String?
  hoursLogged         Float?    // Hours worked on this activity
  workSummary         String?   // Summary of work done
  taskReference       String?   // Reference to task/issue
  status              String    @default("pending") // pending, verified, rejected, changes_requested
  verifiedBy          String?   // Admin who verified/rejected
  verifiedAt          DateTime? // When verification happened
  rejectionReason     String?   // Reason for rejection/changes requested
  feedbackComment     String?   // Detailed feedback from admin
  feedbackAuthor      String?   // Admin who provided feedback
  feedbackTimestamp   DateTime? // When feedback was provided
  contributionType    String    @default("code") // code, documentation, review, hours_logged, meeting, research, task_completion
  contributionWeight  Float     @default(1.0)
  calculatedOwnership Float     @default(0.0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle          BuildCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  verifier       User?      @relation("ActivityVerifier", fields: [verifiedBy], references: [id])
  feedbackGiver  User?      @relation("ActivityFeedback", fields: [feedbackAuthor], references: [id])
  disputes       Dispute[]

  @@map("activity_events")
}

model OwnershipLedger {
  id                 String   @id @default(cuid())
  userId             String
  cycleId            String
  eventType          String
  ownershipAmount    Float
  multiplierSnapshot Float
  sourceReference    String?
  createdBy          String
  createdAt          DateTime @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle BuildCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@map("ownership_ledger")
}

model Multiplier {
  id         String   @id @default(cuid())
  userId     String
  cycleId    String
  multiplier Float
  reason     String?
  createdAt  DateTime @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle BuildCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@map("multipliers")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // stall_warning, participation_paused, activity_verified, multiplier_changed, cycle_started, admin_message
  message   String
  read      Boolean  @default(false)
  metadata  String? // JSON string
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())
  sentAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Dispute {
  id         String    @id @default(cuid())
  userId     String
  activityId String
  reason     String
  status     String    @default("pending") // pending, approved, denied
  resolution String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  resolvedBy String?

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity ActivityEvent @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("disputes")
}

model AuditTrail {
  id            String   @id @default(cuid())
  adminId       String
  action        String // ownership_override, stall_clear, multiplier_restore, dispute_resolution
  targetUserId  String
  previousValue String? // JSON serialized
  newValue      String? // JSON serialized
  reason        String
  timestamp     DateTime @default(now())

  admin      User @relation("AdminAuditTrail", fields: [adminId], references: [id], onDelete: Cascade)
  targetUser User @relation("TargetAuditTrail", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@map("audit_trail")
}

model ArchivedActivity {
  id                  String   @id @default(cuid())
  userId              String
  cycleId             String
  activityType        String
  proofLink           String
  description         String?
  verified            String
  contributionType    String   @default("code")
  contributionWeight  Float    @default(1.0)
  calculatedOwnership Float    @default(0.0)
  archivedAt          DateTime @default(now())
  originalId          String

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle BuildCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@map("archived_activities")
}

model SystemLog {
  id        String   @id @default(cuid())
  event     String
  severity  String   @default("INFO") // DEBUG, INFO, WARNING, ERROR, CRITICAL
  message   String
  timestamp DateTime @default(now())
  userId    String?
  metadata  String? // JSON serialized

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("system_logs")
}

model UserActivitySession {
  id              String    @id @default(cuid())
  userId          String
  sessionStart    DateTime  @default(now())
  sessionEnd      DateTime?
  durationMinutes Int       @default(0)
  pageVisited     String
  lastHeartbeat   DateTime  @default(now())
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_activity_sessions")
}

model ContributionWeight {
  id               String   @id @default(cuid())
  contributionType String   @unique // code, documentation, review, hours_logged, meeting, research, task_completion
  weight           Float    @default(1.0)
  description      String?
  updatedBy        String?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  @@map("contribution_weights")
}

model CycleMessage {
  id        String    @id @default(cuid())
  cycleId   String
  authorId  String
  message   String
  mentions  String    @default("[]") // kept for legacy compat; use MessageMention relation
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  cycle    BuildCycle       @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  author   User             @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reads    MessageRead[]
  mentionedUsers MessageMention[]

  @@map("cycle_messages")
}

model MessageRead {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message CycleMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@map("message_reads")
}

model MessageMention {
  id        String @id @default(cuid())
  messageId String
  userId    String

  message CycleMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@map("message_mentions")
}

model ContributorReputation {
  id                    String   @id @default(cuid())
  userId                String   @unique
  reputationScore       Float    @default(0.0)
  verifiedActivities    Int      @default(0)
  rejectedActivities    Int      @default(0)
  activeCycles          Int      @default(0)
  consistencyScore      Float    @default(0.0)
  totalHoursLogged      Float    @default(0.0)
  lastActivityDate      DateTime?
  calculatedAt          DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("contributor_reputation")
}

model SecurityEvent {
  id          String   @id @default(cuid())
  userId      String
  eventType   String   // new_login, new_device, password_changed, 2fa_enabled, 2fa_disabled, reauth
  ipAddress   String?
  userAgent   String?
  metadata    String?  // JSON
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("security_events")
}

model CycleEngagement {
  id                     String   @id @default(cuid())
  cycleId                String   @unique
  engagementScore        Float    @default(0.0)
  activityCount          Int      @default(0)
  participationRate      Float    @default(0.0)
  verifiedActivityRatio  Float    @default(0.0)
  averageHoursPerUser    Float    @default(0.0)
  messageCount           Int      @default(0)
  calculatedAt           DateTime @default(now())
  updatedAt              DateTime @updatedAt

  cycle BuildCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@map("cycle_engagement")
}

model Agreement {
  id        String   @id @default(cuid())
  version   String   @unique // e.g. "v1.0", "v1.1"
  title     String
  content   String   // Markdown / rich text
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  userAgreements UserAgreement[]

  @@map("agreements")
}

model UserAgreement {
  id          String   @id @default(cuid())
  userId      String
  agreementId String
  acceptedAt  DateTime @default(now())
  ipAddress   String?
  userAgent   String?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@unique([userId, agreementId])
  @@map("user_agreements")
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  cycleId     String
  createdBy   String
  dueDate     DateTime?
  status      String    @default("open") // open, completed, overdue
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  cycle       BuildCycle       @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  creator     User             @relation("TaskCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  assignments TaskAssignment[]

  @@map("tasks")
}

model TaskAssignment {
  id          String    @id @default(cuid())
  taskId      String
  userId      String
  status      String    @default("assigned") // assigned, in_progress, completed
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@map("task_assignments")
}

model ParticipationLeave {
  id         String    @id @default(cuid())
  userId     String
  cycleId    String
  status     String    @default("active") // active, paused, left
  leaveStart DateTime?
  leaveEnd   DateTime?
  reason     String?
  grantedBy  String?   // admin who granted leave
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle BuildCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@map("participation_leave")
}

model AccessGrant {
  id        String   @id @default(cuid())
  userId    String
  grantedBy String
  type      String   // role, feature, cycle_access
  value     String?  // e.g. role name or feature key
  expiresAt DateTime?
  revokedAt DateTime?
  revokedBy String?
  createdAt DateTime @default(now())

  user    User @relation("AccessGrantUser",    fields: [userId],    references: [id], onDelete: Cascade)
  granter User @relation("AccessGrantGranter", fields: [grantedBy], references: [id], onDelete: Cascade)

  @@map("access_grants")
}

model AdminActionLog {
  id            String   @id @default(cuid())
  adminId       String
  action        String   // bulk_grant, bulk_revoke, bulk_force_logout, bulk_remove_cycle, bulk_assign_task, grant_access, revoke_access, role_change, override, etc.
  targetUserIds String   // JSON array
  metadata      String?  // JSON
  createdAt     DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admin_action_logs")
}

// ── Token revocation ─────────────────────────────────────────────────────────

model RevokedToken {
  id        String   @id @default(cuid())
  jti       String   @unique // JWT ID or token hash
  userId    String
  expiresAt DateTime // mirrors JWT exp so we can prune old rows
  revokedAt DateTime @default(now())

  @@index([jti])
  @@index([expiresAt])
  @@map("revoked_tokens")
}

// ── Docs Vault ────────────────────────────────────────────────────────────────

model DocFolder {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  createdAt DateTime @default(now())

  parent    DocFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  DocFolder[] @relation("FolderTree")
  documents Document[]

  @@map("doc_folders")
}

model Document {
  id            String   @id @default(cuid())
  title         String
  filePath      String   // absolute server path — NEVER exposed in API responses
  mimeType      String   @default("application/octet-stream") // e.g. application/pdf, image/png
  size          Int      @default(0) // bytes
  securityLabel String   @default("internal") // internal | restricted | confidential
  folderId      String?
  createdBy     String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  folder    DocFolder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  creator   User              @relation("DocumentCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  access    DocumentAccess[]
  versions  DocumentVersion[]
  activity  DocumentActivity[]

  @@map("documents")
}

model DocumentAccess {
  id         String    @id @default(cuid())
  userId     String
  documentId String
  accessType String    @default("view") // view | download
  expiresAt  DateTime?
  grantedBy  String
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user      User     @relation("DocAccessUser",    fields: [userId],     references: [id], onDelete: Cascade)
  granter   User     @relation("DocAccessGranter", fields: [grantedBy],  references: [id], onDelete: Cascade)
  document  Document @relation(fields: [documentId], references: [id],   onDelete: Cascade)

  @@map("document_access")
}

model DocumentVersion {
  id            String   @id @default(cuid())
  documentId    String
  filePath      String   // absolute server path — NEVER exposed
  mimeType      String   @default("application/octet-stream")
  versionNumber Int
  uploadedBy    String
  createdAt     DateTime @default(now())

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploader  User     @relation("DocVersionUploader", fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@map("document_versions")
}

model DocumentActivity {
  id         String   @id @default(cuid())
  userId     String
  documentId String
  action     String   // view | download | request_access | grant_access | revoke_access | upload_version
  timestamp  DateTime @default(now())
  metadata   String?  // JSON: ip, userAgent, etc.

  user     User     @relation("DocActivityUser", fields: [userId],     references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_activity")
}

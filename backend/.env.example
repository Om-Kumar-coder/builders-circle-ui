# Database (PostgreSQL)
DATABASE_URL=postgresql://builders_user:your_password@localhost:5432/builders_circle

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-minimum-32-chars
JWT_EXPIRES=2h

# Server Configuration
PORT=3001
NODE_ENV=production

# Frontend URL for CORS
FRONTEND_URL=https://yourdomain.com

# Email (Resend) — required for email verification, password reset, security alerts
RESEND_API_KEY=re_your_resend_api_key_here

# File uploads — absolute path on the server where uploaded docs are stored
UPLOAD_DIR=/var/www/builders-circle-ui/uploads

# Google Sheets — Interest form spreadsheet ID (from the URL)
# Sheet must be shared with "Anyone with the link" (view access is enough)
# e.g. https://docs.google.com/spreadsheets/d/SHEET_ID/edit
GOOGLE_SHEET_ID=1MeBtFbMyHbTgR8aU4hV9RWnKKWL_34Qo89gutFRK9DE

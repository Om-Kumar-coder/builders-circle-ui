# ── Frontend (.env.local) ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# reCAPTCHA — Google reCAPTCHA v3 site key for intake form spam protection
# Get one at https://www.google.com/recaptcha/admin
# Leave blank to skip CAPTCHA (form works without it)
# NEXT_PUBLIC_CAPTCHA_SITE_KEY=6Lc...

# ── Backend (backend/.env) — see backend/.env.example for full list ───────────
DATABASE_URL=postgresql://builders_user:your_password@localhost:5432/builders_circle
JWT_SECRET=your-super-secret-jwt-key-here-minimum-32-chars
JWT_EXPIRES=2h
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
RESEND_API_KEY=re_your_resend_api_key_here
UPLOAD_DIR=./uploads

# reCAPTCHA Secret Key — for server-side CAPTCHA validation
# Must match the site key used in NEXT_PUBLIC_CAPTCHA_SITE_KEY
# CAPTCHA_SECRET_KEY=6Lc...

# Akismet API Key — spam protection for intake form submissions
# Get one at https://akismet.com/signup/
# Leave blank to skip Akismet checking
# AKISMET_API_KEY=your_akismet_key
